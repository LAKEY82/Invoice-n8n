# ============================================================================
# InvoiceFlow AI — environment variables
# Copy to .env.local for development. On Vercel, add the same keys under
# Project → Settings → Environment Variables (Production / Preview / Development).
# NEVER prefix a secret with NEXT_PUBLIC_ — those values are shipped to the browser.
# ============================================================================

# --- Core -------------------------------------------------------------------
# MongoDB Atlas connection string (docs/MONGODB_SETUP.md). Include the database name, e.g. /invoiceflow
MONGODB_URI=
# Clerk (https://dashboard.clerk.com -> API keys). Authentication is handled by Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Encrypts integration API keys at rest (AES-256-GCM). >= 32 random chars. Changing it makes stored keys unreadable.
ENCRYPTION_KEY=
# Public base URL of this app. Used in password-reset links and sent to n8n.
#   dev: http://localhost:3000     prod: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cloudflare R2 (docs/R2_SETUP.md) ----------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional, only if you attach a public custom domain. The app never needs it: all access uses signed URLs.
R2_PUBLIC_URL=
# S3 region for the signature. Leave empty for Cloudflare R2 (uses "auto"). Backblaze B2: the region in your endpoint, e.g. us-east-005.
S3_REGION=

# --- n8n (docs/N8N_RENDER_DEPLOYMENT.md) ---------------------------------------
# Full production webhook URL of the workflow, e.g. https://your-n8n.onrender.com/webhook/invoiceflow-process
N8N_WEBHOOK_URL=
# Shared secret. Next.js sends it to n8n AND n8n sends it back on callbacks. Must equal the N8N_API_SECRET set in n8n.
N8N_API_SECRET=
# Used by the n8n service itself (set on Render, not needed by Next.js). Encrypts n8n's stored credentials.
N8N_ENCRYPTION_KEY=
# Optional. If set, Vercel Cron authenticates to /api/internal/recover with it automatically.
CRON_SECRET=
# How long Next.js waits for n8n to accept a job before scheduling a retry (ms). Keep below your function limit.
N8N_DISPATCH_TIMEOUT_MS=8000
# Max attempts per invoice (with exponential backoff 30s, 60s, 2m, 4m, … capped at 15m) before it is marked FAILED.
PROCESSING_MAX_ATTEMPTS=5
# A PROCESSING job with no callback after this many minutes is released and retried.
PROCESSING_TIMEOUT_MINUTES=10

# --- AI provider ---------------------------------------------------------------
# Default provider: gemini | openai. Users can pick a preferred one under Integrations.
AI_PROVIDER=gemini
# Server-wide fallback keys. Users can also save their own (encrypted) under Integrations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Uploads / UI -----------------------------------------------------------------
MAX_UPLOAD_MB=10
UPLOAD_URL_TTL_SECONDS=300
DOWNLOAD_URL_TTL_SECONDS=300
# Status polling interval in ms (only polls while invoices are processing). Public: contains no secret.
NEXT_PUBLIC_POLL_INTERVAL_MS=7000


# Optional: override Node DNS resolvers if mongodb+srv fails with "querySrv ECONNREFUSED"
DNS_SERVERS=
